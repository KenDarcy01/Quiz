{
  "name": "family-quiz",
  "private": true,
  "version": "1.0.0",
  "description": "Family Quiz as iOS and Android apps. The website itself has no build step; this only packages it.",
  "scripts": {
    "build": "node scripts/build-www.mjs",
    "native:assets": "node scripts/render-icons.cjs && capacitor-assets generate --ios --android --iconBackgroundColor '#EEE7FF' --iconBackgroundColorDark '#EEE7FF' --splashBackgroundColor '#EEE7FF' --splashBackgroundColorDark '#EEE7FF'",
    "native:sync": "npm run build && cap sync"
  },
  "dependencies": {
    "@capacitor-community/keep-awake": "^8.0.1",
    "@capacitor/android": "^8.6.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.6.2",
    "@capacitor/share": "^8.0.3",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.6.2"
  }
}
